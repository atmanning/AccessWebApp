# /etc/access-web.env — settings for the access-web systemd service.
# Copy:  sudo install -m 600 -o root deploy/linux/access-web.env.example /etc/access-web.env
NODE_ENV=production
PORT=3000
# 127.0.0.1 when nginx (or another proxy) is in front; 0.0.0.0 to serve directly on your network.
HOST=127.0.0.1
DATA_DIR=/var/lib/access-web

# HTTPS through nginx: true/true. Plain http on a private network with no proxy: false/false.
SECURE_COOKIES=true
TRUST_PROXY=true

# Encrypts saved MySQL passwords. Generate once with:  openssl rand -hex 32
# Keep it: changing it makes saved MySQL passwords unreadable.
CONNECTION_SECRET=replace-with-output-of-openssl-rand-hex-32

# true lets users connect to MySQL servers on this machine or your private network.
# Leave false if the site is open to the internet and users shouldn't reach your internal network.
ALLOW_PRIVATE_DB_HOSTS=false

# Access .accdb export/import (Java). Heap per export; 512m suits 2 GB+ of RAM.
EXPORT_MAX_HEAP=512m
EXPORT_CONCURRENCY=2
